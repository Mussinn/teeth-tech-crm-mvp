# Separate from the Java backend on 8081. Does not load automatically.
HTTP_ADDR=127.0.0.1:8082
HTTP_READ_HEADER_TIMEOUT=5s
HTTP_IDLE_TIMEOUT=60s
HTTP_SHUTDOWN_TIMEOUT=15s

# Optional: without DATABASE_URL the service exposes health endpoints only.
# Use a separate test database prepared by Java Flyway (version 7).
# DATABASE_URL=postgres://test:test@127.0.0.1:55432/teethtech_go_auth_test?sslmode=disable
# JWT_SECRET must match Java: Base64-encoded key, at least 32 decoded bytes.
# JWT_SECRET=
JWT_EXPIRATION=86400000
JWT_REFRESH_EXPIRATION=2592000000
LOGIN_MAX_FAILED_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15
AUTH_RATE_LIMIT_PER_MINUTE=20
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173
# X-Forwarded-For is ignored unless the direct peer belongs to a trusted CIDR.
# TRUSTED_PROXY_CIDRS=127.0.0.1/32

# Personal employee kanban cap (clamped to 1..1000, matching Java)
KANBAN_MAX_CARDS=300

PERSONAL_NOTES_RETENTION_DAYS=30
PERSONAL_NOTES_MAX_ACTIVE_PER_USER=100
