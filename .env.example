MVP_PORT=8090
MVP_BIND_ADDRESS=0.0.0.0
MVP_PUBLIC_URL=http://localhost:8090
MVP_REQUIRE_HTTPS=false
# Optional future modules; keep disabled for MVP. Rebuild frontend when changed.
MVP_WAREHOUSE_ENABLED=false
MVP_FINANCE_ENABLED=false
# Generated by scripts/setup.sh; no default passwords.
POSTGRES_PASSWORD=
MINIO_ROOT_USER=mvp-storage
MINIO_ROOT_PASSWORD=
JWT_SECRET=
MVP_ADMIN_PASSWORD=
# Optional BCrypt hash instead of plaintext; enclose in single quotes.
MVP_ADMIN_PASSWORD_HASH=
# Optional shared password for synthetic training accounts only.
MVP_TRAINING_PASSWORD=
