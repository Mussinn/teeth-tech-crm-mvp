# Local demonstration. For a public server set HTTPS URL and your base domain.
SAAS_PUBLIC_URL=http://localhost:8099
SAAS_BASE_DOMAIN=localhost
SAAS_HTTP_ADDR=127.0.0.1:8099
SAAS_INTERNAL_URL=http://localhost:8099
SAAS_OWNER_EMAIL=owner@teethtech.kz
SAAS_OWNER_PASSWORD=
SAAS_WORKER_SECRET=
SAAS_DB_PASSWORD=
SAAS_DB_PORT=55432
SAAS_LAB_PORT_BASE=12000
SAAS_DATABASE_URL=
SAAS_BACKEND_IMAGE=teethtech-pilot-backend:v1
SAAS_FRONTEND_IMAGE=teethtech-pilot-frontend:v1
SAAS_STORAGE_IMAGE=teethtech-pilot-storage:v1
# Optional encrypted offsite backups: configure BOTH values; remote directory must exist.
SAAS_BACKUP_AGE_RECIPIENT=
SAAS_BACKUP_REMOTE=

# Private 32-byte recovery key outside backups; enables encrypted .ttbk snapshots.
SAAS_BACKUP_KEY_FILE=
